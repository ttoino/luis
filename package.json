{
    "name": "luis",
    "version": "0.0.1",
    "scripts": {
        "dev": "vite dev",
        "build": "vite build",
        "postbuild": "svelte-sitemap",
        "preview": "pnpm run build && wrangler dev",
        "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
        "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
        "lint": "eslint .",
        "lint:fix": "eslint --fix .",
        "format": "prettier --check .",
        "format:fix": "prettier --write .",
        "gen": "pnpm run gen:cf-types",
        "gen:cf-types": "wrangler types src/worker-configuration.d.ts",
        "deploy": "wrangler deploy"
    },
    "devDependencies": {
        "@eslint/compat": "^2.0.5",
        "@eslint/js": "^10.0.1",
        "@oselvar/sveltekit-add-worker-exports": "^0.1.2",
        "@sveltejs/adapter-cloudflare": "^7.2.8",
        "@sveltejs/enhanced-img": "^0.10.4",
        "@sveltejs/kit": "^2.59.0",
        "@sveltejs/vite-plugin-svelte": "^7.0.0",
        "@tailwindcss/typography": "^0.5.19",
        "@tailwindcss/vite": "^4.2.4",
        "@trivago/prettier-plugin-sort-imports": "^6.0.2",
        "@typescript-eslint/eslint-plugin": "^8.59.1",
        "@typescript-eslint/parser": "^8.59.1",
        "eslint": "^10.3.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-perfectionist": "^5.9.0",
        "eslint-plugin-svelte": "^3.17.1",
        "globals": "^17.5.0",
        "prettier": "^3.8.3",
        "prettier-plugin-svelte": "^3.5.1",
        "prettier-plugin-tailwindcss": "^0.8.0",
        "svelte": "^5.55.5",
        "svelte-check": "^4.4.7",
        "svelte-hero-icons": "^5.2.0",
        "svelte-meta-tags": "^4.6.0",
        "svelte-sitemap": "^3.1.0",
        "tailwindcss": "^4.2.4",
        "tslib": "^2.8.1",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.59.1",
        "vite": "^8.0.10",
        "wrangler": "^4.87.0"
    },
    "type": "module",
    "packageManager": "pnpm@11.0.3+sha512.10448f2988933787c6699aef683174c741f6472ad91b7e3c8fe3e2bda57be8a0f7caf58949b8bc22e624578b3dc6e57876ba4c631928a1b84cc141e12c79bccd"
